#!/bin/sh
set -eu
runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export AGENTWORKS_RUNTIME_DIR="$runtime_dir"
mise_bin=$(command -v mise || true)
if [ -z "$mise_bin" ]; then mise_bin="$HOME/.local/bin/mise"; fi
# mise is optional: when present, agent CLIs it manages are on the worker's PATH.
if [ -x "$mise_bin" ]; then
  exec "$mise_bin" -C "$runtime_dir" exec -- "$runtime_dir/agentworks" "$@"
fi
exec "$runtime_dir/agentworks" "$@"
