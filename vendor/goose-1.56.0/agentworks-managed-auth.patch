+// Agentworks embedding hook: the host owns refresh and persistence. The provider
+// receives an access token for each HTTP request and never caches managed tokens.
+pub struct ManagedToken {
+    pub access_token: String,
+    pub account_id: Option<String>,
+}
+pub type ManagedTokenProvider =
+    Arc<dyn Fn() -> BoxFuture<'static, Result<ManagedToken>> + Send + Sync>;
+struct ManagedAuth {
+    tokens: ManagedTokenProvider,
+    endpoint: String,
+}
+static MANAGED_AUTH: std::sync::OnceLock<ManagedAuth> = std::sync::OnceLock::new();
+pub fn set_managed_auth(tokens: ManagedTokenProvider, endpoint: Option<String>) -> Result<()> {
+    MANAGED_AUTH
+        .set(ManagedAuth {
+            tokens,
+            endpoint: endpoint.unwrap_or_else(|| format!("{}/responses", CODEX_API_ENDPOINT)),
+        })
+        .map_err(|_| anyhow!("Managed Codex authentication was already configured"))
+}
 
