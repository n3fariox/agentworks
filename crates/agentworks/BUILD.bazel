load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "agentworks",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "//scripts:embedded_scripts",
        "//web:assets",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.1.0",
    deps = [
        "//crates/agentworks-database",
        "//crates/agentworks-runtime",
        "//crates/agentworks-session",
        "//crates/agentworks-starlark",
        "//crates/agentworks-terminal",
        "//crates/agentworks-presentation",
        "//crates/agentworks-scripting",
        "//crates/agentworks-worker",
        "//crates/agentworks-workspace",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    aliases = aliases(normal = True, normal_dev = True),
    edition = "2024",
    version = "0.1.0",
    compile_data = ["//scripts:embedded_scripts", "//web:assets"],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    deps = [
        "//crates/agentworks-database:test_support",
        "//crates/agentworks-runtime",
        "//crates/agentworks-session",
        "//crates/agentworks-starlark",
        "//crates/agentworks-terminal",
        "//crates/agentworks-presentation",
        "//crates/agentworks-scripting:test_support",
        "//crates/agentworks-worker",
        "//crates/agentworks-workspace",
    ] + all_crate_deps(normal = True, normal_dev = True),
    data = [
        "//tests:fixtures/codex-quota.mjs",
        "@nodejs_host//:node_bin",
    ],
    env = {
        "AGENTWORKS_CODEX_QUOTA_FIXTURE": "$(rootpath //tests:fixtures/codex-quota.mjs)",
        "NODE_BIN": "$(rootpath @nodejs_host//:node_bin)",
    },
)
