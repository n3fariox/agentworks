    "test:diff": "playwright test tests/diff.spec.mjs",
    "test:fork-ui": "playwright test tests/fork.spec.mjs",
    "test:palettes": "playwright test tests/palettes.spec.mjs",
    "test:mentions": "playwright test tests/mentions.spec.mjs",
    "test:display": "playwright test tests/display-preferences.spec.mjs",
    "test:hosting": "playwright test tests/hosting.spec.mjs",
    "test:notifications": "playwright test tests/notifications.spec.mjs",
    "test:service-restart": "node scripts/service-restart-smoke.mjs",
    "test:supervisor": "python3 scripts/service/supervisor-test.py",
    "prepare:coordinator": "node scripts/prepare-self-improvement.mjs",
    "test:codex-quota": "playwright test tests/codex-subscription.spec.mjs",
    "test:review-queue": "node scripts/review-queue-smoke.mjs",
