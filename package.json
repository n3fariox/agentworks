    "test:starlark": "cargo test --locked -p agentworks-starlark",
    "test:progress": "node --test tests/bazel-progress.test.mjs && node scripts/progress-smoke.mjs",
    "test:tool-bodies": "node scripts/tool-bodies-smoke.mjs && playwright test tests/tool-bodies.spec.mjs",
    "test:async-tasks": "playwright test tests/async-tasks.spec.mjs",
    "test:subagents": "node tests/subagents.test.mjs && playwright test tests/subagents.spec.mjs",
    "readme:media": "node scripts/readme-media/capture.mjs",
    "test:attachments": "playwright test tests/attachments.spec.mjs",
